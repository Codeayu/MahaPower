# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google API Configuration
GOOGLE_API_KEY=your-google-api-key-here

# Azure OpenAI Configuration
# Generation API Configuration
AZURE_OPENAI_GENERATION_API_KEY=your-azure-openai-generation-api-key
AZURE_OPENAI_GENERATION_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_GENERATION_MODEL=gpt-35-turbo

# Embedding API Configuration  
AZURE_OPENAI_EMBEDDING_API_KEY=your-azure-openai-embedding-api-key
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource-name.openai.azure.com/
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# API Version
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Django Configuration
DEBUG=True
SECRET_KEY=your-django-secret-key-here

# Email Configuration (if needed)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Database Configuration (if using PostgreSQL/MySQL)
# DATABASE_URL=your-database-url

# Render/Production Configuration
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com